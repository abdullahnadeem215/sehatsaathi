{
  "name": "Sehat Saathi — Gentle Health Companion",
  "short_name": "Sehat Saathi",
  "description": "Voice-first discharge instruction assistant and emergency alert system for patients and caregivers.",
  "id": "com.sehatsaathi.app",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "window-controls-overlay"],
  "orientation": "portrait",
  "background_color": "#f7faf7",
  "theme_color": "#246b38",
  "categories": ["medical", "health", "lifestyle"],
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "192x192",
      "type": "image/svg+xml"
    },
    {
      "src": "/icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Patient Companion",
      "short_name": "Patient",
      "description": "Talk to your gentle voice health companion",
      "url": "/?role=patient",
      "icons": [{ "src": "/icon.svg", "sizes": "192x192" }]
    },
    {
      "name": "Caregiver Alerts",
      "short_name": "Caregiver",
      "description": "View live alerts, patient adherence, and emergency buzzer",
      "url": "/?role=caregiver",
      "icons": [{ "src": "/icon.svg", "sizes": "192x192" }]
    }
  ]
}
