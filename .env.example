# Global default: amd | huggingface | groq | openrouter | mock
AI_PROVIDER=mock

# Optional per-capability overrides (leave empty to use AI_PROVIDER)
LLM_PROVIDER=
STT_PROVIDER=
TTS_PROVIDER=

# Fallback behaviour
AUTO_FALLBACK=true
FALLBACK_PROVIDER=huggingface
PROVIDER_TIMEOUT_SECONDS=12

# AMD Developer Cloud (vLLM, OpenAI-compatible)
AMD_LLM_BASE_URL=https://amd-vllm-endpoint.example.com/v1
AMD_LLM_API_KEY=your-amd-vllm-key
AMD_LLM_MODEL=meta-llama/Llama-3-8B-Instruct
AMD_STT_URL=https://amd-speech-endpoint.example.com/stt
AMD_STT_MODEL=openai/whisper-large-v3
AMD_TTS_URL=https://amd-speech-endpoint.example.com/tts
AMD_TTS_MODEL=urdu-tts-fastspeech2

# Hugging Face (free models)
HF_TOKEN=hf_your_token_here
HF_API_BASE_URL=https://router.huggingface.co/hf-inference/models
HF_LLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
HF_STT_MODEL=openai/whisper-large-v3
HF_TTS_MODEL=facebook/mms-tts-urd-script_arabic

# Groq Cloud (optional)
GROQ_API_KEY=
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3

# OpenRouter (optional)
OPENROUTER_API_KEY=
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Safety and operations
CONFIDENCE_THRESHOLD=0.6
OPERATOR_TOKEN=replace-with-a-long-random-operator-token

# Caregiver pairing (new in v1.1)
PAIRING_KEY_TTL_SECONDS=600
PAIRING_MAX_FAILURES=5
PAIRING_FAILURE_WINDOW_SECONDS=600
PAIRING_CONSENT_TIMEOUT_SECONDS=120

# Optional demo bypass, leave empty to disable
DASHBOARD_ACCESS_CODE=

# Database configuration
DATABASE_PATH=sehat_saathi.db
